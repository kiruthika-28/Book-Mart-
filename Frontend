<!DOCTYPE html>
<html>
<head>
    <title>BookMart - Online Book Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }

        h1 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid black;
            padding: 10px;
            text-align: center;
        }

        button {
            padding: 8px 15px;
            cursor: pointer;
        }

        #cart {
            margin-top: 30px;
        }
    </style>
</head>

<body>

<h1>BOOKMART - ONLINE BOOK MANAGEMENT</h1>

<h2>Login</h2>

<input type="text" id="username" placeholder="Username">

<input type="password" id="password" placeholder="Password">

<button onclick="login()">Login</button>

<p id="message"></p>

<h2>Available Books</h2>

<table>

    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Author</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Action</th>
    </tr>

    <tbody id="bookTable"></tbody>

</table>

<div id="cart">

    <h2>Shopping Cart</h2>

    <ul id="cartItems"></ul>

    <h3 id="total">Total: Rs.0</h3>

    <button onclick="checkout()">Checkout</button>

</div>

<script>

let books = [

    {
        id: 1,
        title: "Java Programming",
        author: "Herbert Schildt",
        category: "Programming",
        price: 450,
        stock: 10
    },

    {
        id: 2,
        title: "Python Basics",
        author: "Mark Lutz",
        category: "Programming",
        price: 400,
        stock: 8
    },

    {
        id: 3,
        title: "Data Science",
        author: "John Smith",
        category: "Data Science",
        price: 550,
        stock: 5
    },

    {
        id: 4,
        title: "Artificial Intelligence",
        author: "Stuart Russell",
        category: "AI",
        price: 650,
        stock: 6
    }

];

let cart = [];

function login() {

    let username =
        document.getElementById("username").value;

    document.getElementById("message").innerHTML =
        "Welcome " + username;
}

function displayBooks() {

    let table =
        document.getElementById("bookTable");

    books.forEach((book) => {

        table.innerHTML += `

        <tr>

            <td>${book.id}</td>

            <td>${book.title}</td>

            <td>${book.author}</td>

            <td>${book.category}</td>

            <td>Rs.${book.price}</td>

            <td>${book.stock}</td>

            <td>

                <button onclick="addToCart(${book.id})">

                    Add

                </button>

            </td>

        </tr>

        `;
    });
}

function addToCart(id) {

    let book =
        books.find((b) => b.id === id);

    cart.push(book);

    updateCart();

    alert("Book added successfully!");
}

function updateCart() {

    let list =
        document.getElementById("cartItems");

    let total = 0;

    list.innerHTML = "";

    cart.forEach((book) => {

        total += book.price;

        list.innerHTML +=
            "<li>" +
            book.title +
            " - Rs." +
            book.price +
            "</li>";
    });

    document.getElementById("total").innerHTML =
        "Total: Rs." + total;
}

function checkout() {

    if (cart.length === 0) {

        alert("Cart is empty");

        return;
    }

    alert("Payment Successful!\nOrder Confirmed!");
}

displayBooks();

</script>

</body>
</html>